---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ProjectDetail from "../components/ProjectDetail.astro";
import LiveCommits from "../components/LiveCommits.astro";
import profile from "../data/profile.json";

const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

// Bold the emphasised phrases inside the headline
let headline = profile.headline.replace(/&/g, "&amp;").replace(/</g, "&lt;");
for (const phrase of profile.headlineEmphasis) headline = headline.replace(phrase, `<b>${phrase}</b>`);

const ghUser = profile.github.replace(/^https:\/\/github\.com\//, "");
---
<Base>
  <main class="wrap" id="main">
    <header class="hero">
      <div class="hero-top">
        <div class="hero-text">
          <span class="label">Portfolio · {profile.location}</span>
          <h1>{profile.name.replace(/-/g, "‑")}</h1>
          <p class="role" set:html={headline} />
          <div class="meta">
            {profile.tags.map((t) => <span>{t}</span>)}
            <a href={profile.github}>github.com/{ghUser}</a>
          </div>
        </div>
        <picture class="portrait">
          <source srcset="/portrait.webp" type="image/webp" />
          <img src="/portrait.jpg" width="480" height="600" alt={`Portrait of ${profile.name}`} fetchpriority="high" />
        </picture>
      </div>
    </header>

    <section>
      <div class="sec-head"><h2>About</h2></div>
      <div class="intro">
        {profile.about.map((p) => <p>{p}</p>)}
      </div>
    </section>

    <section id="projects">
      <div class="sec-head"><h2>Projects</h2></div>
      <div class="pgrid">
        {projects.map((p) => <ProjectCard project={p} />)}
      </div>
    </section>

    <section>
      <div class="sec-head"><h2>Toolbox</h2></div>
      <div class="tools">
        {profile.toolbox.map((g) => (
          <div>
            <h3>{g.title}</h3>
            <ul>
              {g.items.map((i) => (
                <li>{i.name}{i.note && <> <span>{i.note}</span></>}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section>
      <div class="sec-head"><h2>Background</h2></div>
      <ol class="tl">
        {profile.timeline.map((t) => (
          <li><span class="when">{t.when}</span><div><strong>{t.title}</strong><p>{t.text}</p></div></li>
        ))}
      </ol>
    </section>

    <footer>
      <h2>Get in touch</h2>
      <p>{profile.contact}</p>
      <dl class="contact">
        <div><dt>Email</dt><dd><a href={`mailto:${profile.email}`}>{profile.email}</a></dd></div>
        <div><dt>GitHub</dt><dd><a href={profile.github}>github.com/{ghUser}</a></dd></div>
      </dl>
    </footer>
  </main>


  {projects.map((p) => (
    <dialog class="sheet" id={`dlg-${p.id}`} aria-labelledby={`dlg-${p.id}-title`}>
      <div class="sheet-bar">
        <a class="sheet-link" href={`/projects/${p.id}/`}>Open as page</a>
        <button type="button" class="sheet-close" data-close aria-label="Close">×</button>
      </div>
      <ProjectDetail project={p} headingId={`dlg-${p.id}-title`} />
    </dialog>
  ))}
  <LiveCommits />

  <script>
    // Open a project's write-up in an overlay instead of navigating, and keep the
    // address bar in step (/projects/<id>/) so Back closes it and the URL can be shared.
    const home = location.pathname;
    let openId: string | null = null;

    const dlg = (id: string) => document.getElementById(`dlg-${id}`) as HTMLDialogElement | null;

    function show(id: string) {
      const d = dlg(id);
      if (!d || d.open) return;
      d.showModal();
      d.scrollTop = 0;
      openId = id;
    }
    function hide() {
      if (!openId) return;
      dlg(openId)?.close();
      openId = null;
    }

    document.querySelectorAll<HTMLAnchorElement>("a.pcard[data-project]").forEach((a) => {
      a.addEventListener("click", (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return; // new tab etc.
        e.preventDefault();
        const id = a.dataset.project!;
        history.pushState({ project: id }, "", a.href);
        show(id);
      });
    });

    document.querySelectorAll<HTMLDialogElement>("dialog.sheet").forEach((d) => {
      // a click on the dimmed backdrop (outside the panel) closes it
      d.addEventListener("click", (e) => {
        if (e.target === d) requestClose();
      });
      d.querySelector("[data-close]")?.addEventListener("click", requestClose);
      // Esc: let history drive the close so the URL goes back too
      d.addEventListener("cancel", (e) => {
        e.preventDefault();
        requestClose();
      });
    });

    function requestClose() {
      if (history.state?.project) history.back();
      else {
        hide();
        history.replaceState(null, "", home);
      }
    }

    window.addEventListener("popstate", (e) => {
      const id = e.state?.project as string | undefined;
      if (id) show(id);
      else hide();
    });
  </script>
</Base>
