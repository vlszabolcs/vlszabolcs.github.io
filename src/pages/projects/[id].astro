---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import ProjectDetail from "../../components/ProjectDetail.astro";
import LiveCommits from "../../components/LiveCommits.astro";
import profile from "../../data/profile.json";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => !data.draft);
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}
const { project } = Astro.props;
---
<Base title={`${project.data.title} · ${profile.name}`} description={project.data.summary}>
  <main class="wrap page" id="main">
    <nav class="crumbs"><a href="/#projects">← {profile.name}</a></nav>
    <ProjectDetail project={project} as="h1" />
    <footer>
      <h2>Get in touch</h2>
      <p>{profile.contact}</p>
      <dl class="contact">
        <div><dt>Email</dt><dd><a href={`mailto:${profile.email}`}>{profile.email}</a></dd></div>
        <div><dt>GitHub</dt><dd><a href={profile.github}>{profile.github.replace("https://", "")}</a></dd></div>
      </dl>
    </footer>
  </main>
  <LiveCommits />
</Base>
