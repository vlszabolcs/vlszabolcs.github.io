---
// Small silhouette illustrations shown beside a project's description.
// Pick one with `art: <name>` in the project's frontmatter.
interface Props {
  name: string;
}
const { name } = Astro.props;
---
{name === "rfid-coffee" && (
  <svg class="proj-art" viewBox="0 0 168 104" role="img" aria-label="An RFID card tapped next to a coffee mug">
    <!-- RFID card -->
    <g class="sil">
      <rect x="6" y="34" width="64" height="44" rx="6" />
    </g>
    <rect class="cut" x="15" y="46" width="14" height="11" rx="2" />
    <rect class="cut" x="15" y="64" width="34" height="4" rx="2" />
    <!-- contactless waves -->
    <g class="hot" fill="none" stroke-width="4" stroke-linecap="round">
      <path d="M78 46 a14 14 0 0 1 0 20" />
      <path d="M86 40 a22 22 0 0 1 0 32" />
    </g>
    <!-- mug -->
    <g class="sil">
      <path d="M104 44 h40 v34 a12 12 0 0 1 -12 12 h-16 a12 12 0 0 1 -12 -12 z" />
      <path d="M144 50 h6 a10 10 0 0 1 0 20 h-6 v-6 h6 a4 4 0 0 0 0 -8 h-6 z" />
      <rect x="98" y="92" width="58" height="5" rx="2.5" />
    </g>
    <!-- steam -->
    <g class="hot" fill="none" stroke-width="3.5" stroke-linecap="round">
      <path d="M116 36 c-5 -6 5 -10 0 -18" />
      <path d="M128 36 c-5 -6 5 -10 0 -18" />
    </g>
  </svg>
)}
